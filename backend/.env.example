# Character OS backend env
#
# LLM provider for concept generation.
#   - "openai" (default) — uses OPENAI_API_KEY against the cloud API
#   - "ollama" — uses a local Ollama server (no API key required);
#               operator must `ollama pull <model>` once + keep the
#               Ollama app/`ollama serve` running.
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# Copy to .env and fill in keys to leave mock mode.

# Runway API (https://dev.runwayml.com)
RUNWAY_API_KEY=
RUNWAY_API_BASE=https://api.dev.runwayml.com
RUNWAY_API_VERSION=2024-11-06
RUNWAY_MODEL=gen4_turbo

# OpenAI for concept generation (optional; mock mode if blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server
ALLOWED_ORIGINS=http://localhost:5173
DATA_DIR=./data
